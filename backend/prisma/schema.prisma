generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum PlatformRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  INVITE
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  ROLE_CHANGED
  MEMBER_ADDED
  MEMBER_REMOVED
  SUSPEND
  REACTIVATE
  APPROVE
  REJECT

  USER_REGISTERED
  ORGANIZATION_CREATED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_DEACTIVATED

  CASE_CREATED
  CASE_ASSIGNED
  CASE_REASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED

  INVESTIGATION_STARTED
  INVESTIGATION_UPDATED
  EVIDENCE_UPLOADED
  EVIDENCE_ACCESSED

  MESSAGE_SENT

  RESOLUTION_PROPOSED
  RESOLUTION_ACCEPTED
  RESOLUTION_REJECTED

  CASE_ESCALATED
  CASE_CLOSED
}

enum AuditEntity {
  USER
  COMPANY
  MEMBERSHIP
  INVITATION
  ROLE
  PERMISSION
  CASE
  SLA
  EVIDENCE
  COMMENT
  SYSTEM
}

/**
 * =========================================================
 * USER
 * =========================================================
 */

model User {
  id String @id @default(uuid())

  // Clerk identity
  clerkId String @unique

  name  String?
  email String  @unique

  phone String? @unique

  avatar UserImage?

  address String?
  city    String?
  state   String?
  country String?

  platformRole PlatformRole @default(USER)
  status       UserStatus   @default(ACTIVE)

  lastLoginAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships CompanyMember[]

  sentInvitations CompanyInvitation[] @relation("InvitationInviter")

  auditLogs AuditLog[] @relation("AuditActor")
  cases     Case[]     @relation("CaseCreator")

  @@index([email])
  @@index([clerkId])
  @@index([status])
  @@index([platformRole])
}

/**
 * =========================================================
 * USER IMAGE
 * =========================================================
 */

model UserImage {
  id String @id @default(uuid())

  url      String
  publicId String

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * =========================================================
 * COMPANY
 * =========================================================
 */

model Company {
  id String @id @default(uuid())

  // Corresponding Clerk Organization
  clerkOrganizationId String @unique

  name String

  slug String @unique

  email String?

  phone String?

  website String?

  logoUrl String?

  description String?

  address String?
  city    String?
  state   String?
  country String?

  status CompanyStatus @default(ACTIVE)

  memberships CompanyMember[]

  invitations CompanyInvitation[]

  roles CompanyRole[]

  cases Case[]

  auditLogs AuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([status])
}

/**
 * =========================================================
 * COMPANY MEMBERSHIP
 * =========================================================
 */

model CompanyMember {
  id String @id @default(uuid())

  userId    String
  companyId String

  roleId String

  status MembershipStatus @default(ACTIVE)

  department String?

  jobTitle String?

  employeeId String?

  joinedAt    DateTime  @default(now())
  suspendedAt DateTime?
  removedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  role CompanyRole @relation(fields: [roleId], references: [id])

  caseAssignments CaseAssignment[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
  @@index([roleId])
  @@index([status])
}

/**
 * =========================================================
 * COMPANY ROLES
 * =========================================================
 */

model CompanyRole {
  id String @id @default(uuid())

  companyId String?

  name String

  slug String

  description String?

  /**
   * The corresponding Clerk organization role.
   * Example:
   * org:owner
   * org:admin
   * org:staff
   * org:investigator
   */
  clerkRole String

  isSystem Boolean @default(false)

  isDefault Boolean @default(false)

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  members CompanyMember[]

  invitations CompanyInvitation[]

  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@unique([companyId, clerkRole])
  @@index([companyId])
}

/**
 * =========================================================
 * PERMISSIONS
 * =========================================================
 */

model Permission {
  id String @id @default(uuid())

  name String

  slug String @unique

  description String?

  resource String

  action String

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * =========================================================
 * ROLE ↔ PERMISSION
 * =========================================================
 */

model RolePermission {
  roleId       String
  permissionId String

  role CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/**
 * =========================================================
 * COMPANY INVITATION
 * =========================================================
 */

model CompanyInvitation {
  id String @id @default(uuid())

  companyId String

  roleId String

  invitedById String

  email String

  /**
   * Clerk's invitation ID.
   * ResolveHub should NOT store or generate
   * its own authentication token.
   */
  clerkInvitationId String @unique

  status InvitationStatus @default(PENDING)

  department String?

  jobTitle String?

  employeeId String?

  expiresAt DateTime

  acceptedAt DateTime?

  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  role CompanyRole @relation(fields: [roleId], references: [id])

  invitedBy User @relation("InvitationInviter", fields: [invitedById], references: [id])

  @@index([companyId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([roleId])
}

/**
 * =========================================================
 * AUDIT LOG
 * =========================================================
 */

model AuditLog {
  id String @id @default(uuid())

  actorId String?

  companyId String?

  action AuditAction

  entity AuditEntity

  entityId String?

  /**
   * Useful for storing information about
   * what changed without creating many columns.
   */
  metadata Json?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([companyId])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

/**
 * =========================================================
 * CASE
 * =========================================================
 */

model Case {
  id String @id @default(uuid())

  companyId String

  caseNumber String @unique

  title String

  description String?

  status String

  priority String?

  createdById String

  assignedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  assignments CaseAssignment[]

  createdBy User @relation("CaseCreator", fields: [createdById], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
}

/**
 * =========================================================
 * CASE ASSIGNMENT
 * =========================================================
 */

model CaseAssignment {
  id String @id @default(uuid())

  caseId   String
  memberId String

  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  member CompanyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([memberId])
}
